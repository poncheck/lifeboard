# Only secrets go here. Everything else (ports, feature flags, etc.) lives in
# config/dashboard.yaml or is set through the admin panel at runtime.

# Required. A random string (32+ chars) used to derive the key that encrypts
# integration credentials at rest (Fernet) and to sign session cookies.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
