# Default dashboard layout — copy this to dashboard.yaml and customize.
# dashboard.yaml is gitignored (it's your personal layout); this .example
# file is the only one tracked in the repo.

modules:
  - module_id: clock
    enabled: true
    position: 0
    refresh_seconds: 1
  - module_id: training_readiness
    enabled: false
    position: 1
    refresh_seconds: 300
  - module_id: weather
    enabled: false
    position: 2
    refresh_seconds: 300
  - module_id: location
    enabled: false
    position: 3
    refresh_seconds: 60
  - module_id: nutrition
    enabled: false
    position: 4
    refresh_seconds: 60
  - module_id: portfolio
    enabled: false
    position: 5
    refresh_seconds: 1800
  - module_id: echo
    enabled: false
    position: 6
    refresh_seconds: 30
